# `next dev` runs without wrangler and reads these instead of wrangler.jsonc vars.
WRANGLER_BINDING=off
API_URL=http://localhost:3848
BAKERY_TIME_ZONE=Europe/Prague
WEB_ORIGIN=http://localhost:3847
# Build-time: the prerendered pages' share links resolve here.
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3847
# Turnstile test site key, always passes; pairs with the API's test secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
