{
  "name": "@craftsman-bakery/web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun next dev --port 3847",
    "build": "bun --bun next build",
    "build:worker": "./scripts/build-worker.sh",
    "preview": "bun --env-file=.env.preview run build:worker --env preview && opennextjs-cloudflare preview --env preview --port 3847",
    "typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false cloudflare-env.d.ts && next typegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "test": "bun test test"
  },
  "dependencies": {
    "@craftsman-bakery/contracts": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "trustedDependencies": []
}
