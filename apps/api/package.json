{
  "name": "@acme-bakery/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "db:generate": "bun --env-file=.env.development drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.development drizzle-kit migrate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun --env-file=.env.test test",
    "preview": "wrangler dev --env-file .env.development --port 3848",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@acme-bakery/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "pg": "^8.23.1",
    "zod": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "wrangler": "^4.168.0"
  },
  "trustedDependencies": []
}
