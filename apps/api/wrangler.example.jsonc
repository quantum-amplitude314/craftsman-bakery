{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "craftsman-bakery-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable only through the web Worker's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "vars": {
    "BAKERY_TIME_ZONE": "Europe/Prague",
    "CUTOFF_TIME": "18:00",
    "WEB_ORIGIN": "https://craftsman-bakery.example.com"
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY"] },
  "ai": { "binding": "AI" },
  "hyperdrive": [
    { "binding": "HYPERDRIVE_COMMANDS", "id": "<hyperdrive id, caching off>" },
    { "binding": "HYPERDRIVE_QUERIES", "id": "<hyperdrive id, caching on>" }
  ],
  "env": {
    // `dev`: workerd against the local development database.
    "development": {
      "vars": {
        "BAKERY_TIME_ZONE": "Europe/Prague",
        "CUTOFF_TIME": "18:00",
        "WEB_ORIGIN": "http://localhost:3847"
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY"] },
      "ai": { "binding": "AI" },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_COMMANDS",
          "id": "<hyperdrive id, caching off>",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5435/craftsman_bakery"
        },
        {
          "binding": "HYPERDRIVE_QUERIES",
          "id": "<hyperdrive id, caching on>",
          "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5435/craftsman_bakery"
        }
      ]
    },
    // `preview`: workerd against the Neon preview branch, direct connection string.
    "preview": {
      "vars": {
        "BAKERY_TIME_ZONE": "Europe/Prague",
        "CUTOFF_TIME": "18:00",
        "WEB_ORIGIN": "http://localhost:3847"
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY"] },
      "ai": { "binding": "AI" },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_COMMANDS",
          "id": "<hyperdrive id, caching off>",
          "localConnectionString": "postgres://user:password@neon-preview-branch-host/neondb?sslmode=require"
        },
        {
          "binding": "HYPERDRIVE_QUERIES",
          "id": "<hyperdrive id, caching on>",
          "localConnectionString": "postgres://user:password@neon-preview-branch-host/neondb?sslmode=require"
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true }
  }
}
