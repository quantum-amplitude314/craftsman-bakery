{
  "name": "craftsman-bakery",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/contract": "^1.16.5",
      "typescript": "^7.0.2",
      "zod": "^4.6.7",
      "@orpc/openapi": "^1.16.5",
      "@orpc/server": "^1.16.5",
      "better-auth": "^1.7.28",
      "@orpc/client": "^1.16.5",
      "@orpc/openapi-client": "^1.16.5",
      "wrangler": "^4.168.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:fix": "biome check --write . && biome check --write --vcs-use-ignore-file=false --no-errors-on-unmatched packages/maintain/demo packages/maintain/worker",
    "db:up": "podman compose up -d --wait",
    "db:down": "podman compose down",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:migrate:preview": "bun run --cwd apps/api db:migrate:preview",
    "db:migrate:production": "bun run --cwd apps/api db:migrate:production",
    "demo:seed": "bun run --cwd packages/maintain demo:seed",
    "demo:seed:preview": "bun run --cwd packages/maintain demo:seed:preview",
    "demo:seed:production": "bun run --cwd packages/maintain demo:seed:production"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "trustedDependencies": []
}
