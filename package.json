{
  "name": "acme-bakery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/contract": "^1.16.5",
      "typescript": "^7.0.2",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint-fix": "biome check --write .",
    "db:up": "podman compose up -d --wait",
    "db:down": "podman compose down",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  },
  "trustedDependencies": []
}
